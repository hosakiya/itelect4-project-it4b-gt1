{
  "installCommand": "npm ci --prefix GT2P3",
  "buildCommand": "npm run build --prefix GT2P3",
  "outputDirectory": "GT2P3/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://itelect4-backend-eosin.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
